    "expected_effects": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Expected Effects",
      "type": "array"
    },
    "risks": {
      "items": {
        "type": "string"
      },
      "title": "Risks",
      "type": "array"
    },
    "verification_checks": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Verification Checks",
      "type": "array"
