{
  "$defs": {
    "DatasheetEvidence": {
      "additionalProperties": false,
      "properties": {
        "document": {
          "minLength": 1,
          "title": "Document",
          "type": "string"
        },
        "manufacturer": {
          "minLength": 1,
          "title": "Manufacturer",
          "type": "string"
        },
        "revision": {
          "minLength": 1,
          "title": "Revision",
          "type": "string"
        },
        "page": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "section": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section"
        },
        "extracted_constraint": {
          "minLength": 1,
          "title": "Extracted Constraint",
          "type": "string"
        },
        "source_location": {
          "minLength": 1,
          "title": "Source Location",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "document",
        "manufacturer",
        "revision",
        "extracted_constraint",
        "source_location"
      ],
      "title": "DatasheetEvidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "decision": {
      "minLength": 1,
      "title": "Decision",
      "type": "string"
    },
    "context": {
      "minLength": 1,
      "title": "Context",
      "type": "string"
    },
    "alternatives": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Alternatives",
      "type": "array"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/DatasheetEvidence"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    },
    "calculations": {
      "items": {
        "type": "string"
      },
      "title": "Calculations",
      "type": "array"
    },
    "risks": {
      "items": {
        "type": "string"
      },
      "title": "Risks",
      "type": "array"
    },
    "chosen_solution": {
      "minLength": 1,
      "title": "Chosen Solution",
      "type": "string"
    },
    "consequences": {
      "items": {
        "type": "string"
      },
      "title": "Consequences",
      "type": "array"
    },
    "invalidated_by": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Invalidated By",
      "type": "array"
    }
  },
  "required": [
    "id",
    "decision",
    "context",
    "alternatives",
    "evidence",
    "calculations",
    "risks",
    "chosen_solution",
    "consequences",
    "invalidated_by"
  ],
  "title": "Decision",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
