ASTRA_MODEL=gpt-6-astra
OPENAI_API_KEY=
KICAD_MCP_URL=
PARTS_MCP_URL=
FREECAD_MCP_URL=
DATASHEETS_MCP_URL=

# Qualified optional KiCad MCP checkout; no credentials required for local stdio.
KANON_KICAD_MCP_ROOT=/path/to/qualified/KiCAD-MCP-Server
KICAD_BACKEND=swig
KICAD_AUTO_LAUNCH=false
KICAD_MCP_LOG_LEVEL=error
# JLCSearch and Adafruit public catalog lookups require no account or credentials.
# Select explicitly: astra-pcb source-part 2821 --provider adafruit --expected-mpn ADA2821
