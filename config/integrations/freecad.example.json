{
  "provider": "https://github.com/neka-nat/freecad-mcp",
  "status": "QUALIFIED_LOCAL_DESIGNER_SUBSET",
  "launch": {
    "command": "${KANON_FREECAD_MCP_ROOT}/.venv/bin/freecad-mcp",
    "args": [
      "--host",
      "127.0.0.1"
    ]
  },
  "requirements": [
    "FreeCAD installed",
    "Audited provider addon loaded in isolated FreeCAD session"
  ],
  "designer": {
    "enabled": true,
    "tools": [
      {
        "operation": "mechanical.document.create",
        "remote_tool": "create_document",
        "access": "WRITE"
      },
      {
        "operation": "mechanical.object.create",
        "remote_tool": "create_object",
        "access": "WRITE"
      },
      {
        "operation": "mechanical.object.read",
        "remote_tool": "get_object",
        "access": "READ"
      },
      {
        "operation": "mechanical.objects.read",
        "remote_tool": "get_objects",
        "access": "READ"
      }
    ],
    "require_explicit_enclosure_edit_intent": true
  },
  "reviewer": {
    "enabled": false,
    "tools": [],
    "source_access": "none"
  },
  "secrets": "Environment variables only; do not store credentials here",
  "notice": "Designer subset qualified on pinned provider/FreeCAD 1.1.3. Never expose this server or its execute_code tool to Reviewer. RPC is unauthenticated loopback: private host/session only. Missing-object null is an error. Native readback required after mutations.",
  "application_qualification": {
    "version": "1.1.3",
    "distribution": "Official Linux x86_64 AppImage",
    "sha256": "3a853eb69ee595f779f2255dbf80a765926981d8ff68903cefee4dfb03a8f5ef",
    "tested": [
      "GUI startup in isolated Xvfb",
      "FreeCADCmd version",
      "FCStd and STEP round trip"
    ],
    "documentation": "docs/freecad.md",
    "does_not_qualify_mcp": true
  },
  "provider_commit": "5dbfe2c80b53c3102bff0723951676e16edf2d84",
